# Supabase Connect > Project URL (untuk Supabase JS / Data API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Connect > Publishable key (aman untuk browser, akses dibatasi RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Connect > Transaction pooler (runtime Next.js, port 6543)
DATABASE_URL=
# Supabase Connect > Direct connection atau Session pooler (migrasi, port 5432)
MIGRATION_DATABASE_URL=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Opsional: kredensial lama tetap dibaca sampai diisi melalui /admin/settings
GMAIL_APP_PASSWORD=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
